{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian — read-only AI portfolio judgment layer for Indian retail traders. Daily personalized briefs, deterministic risk snapshots, and behavioral journaling on top of Zerodha (Kite Connect). No order placement, ever.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "job:daily-brief": "tsx src/jobs/dailyBrief.ts",
    "job:weekly-journal": "tsx src/jobs/weeklyJournal.ts",
    "job:prices": "tsx src/jobs/ingestPrices.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@fastify/cookie": "^11.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "kiteconnect": "^5.3.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "razorpay": "^2.9.6",
    "resend": "^6.17.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
