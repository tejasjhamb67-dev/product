# --- Core ---
NODE_ENV=development
PORT=3000
# Base URL of this app (used in Kite OAuth redirect + email links)
APP_BASE_URL=http://localhost:3000

# --- Postgres (Supabase / Neon / local) ---
DATABASE_URL=postgres://user:pass@localhost:5432/meridian

# --- Secrets ---
# 32-byte hex key for AES-256-GCM encryption of broker access tokens at rest.
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Secret for signing session cookies. Generate: openssl rand -hex 32
SESSION_SIGNING_KEY=

# --- Anthropic (brief generation) ---
ANTHROPIC_API_KEY=
# Sonnet-tier per deployment plan; shared market context is prompt-cached across users.
BRIEF_MODEL=claude-sonnet-5

# --- Zerodha Kite Connect (read-only scopes; we never place orders) ---
KITE_API_KEY=
KITE_API_SECRET=

# --- Email delivery (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Meridian <brief@yourdomain.in>"

# --- Razorpay subscriptions ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_CORE=
RAZORPAY_PLAN_ID_PRO=
